/* znc TUI — 전역 스타일 */

$bg:        #0d1117;
$bg-panel:  #161b22;
$bg-hover:  #1c2128;
$bg-active: #21262d;
$border:    #30363d;
$text:      #e6edf3;
$text-dim:  #8b949e;
$text-muted:#484f58;
$accent:    #58a6ff;
$accent2:   #79c0ff;
$success:   #3fb950;
$warning:   #d29922;
$error:     #f85149;
$user-msg:  #1c2128;
$ai-msg:    #0d1117;

Screen {
    background: $bg;
    color: $text;
    layout: vertical;
    overflow: hidden hidden;
}

/* main-layout: 사이드바 + 채팅창 가로 배치, keybind-bar 위 공간 전체 사용 */
#main-layout {
    height: 1fr;
    layout: horizontal;
}

/* ── 사이드바 ─────────────────────────────────────── */
#sidebar {    width: 26;
    min-width: 26;
    height: 100%;
    background: $bg-panel;
    border-right: tall $border;
    padding: 0;
}

#sidebar.--hidden {
    display: none;
}

#sidebar-title {
    background: $bg-panel;
    color: $accent;
    text-style: bold;
    padding: 0 1;
    height: 1;
}

#project-list {
    background: $bg-panel;
    height: auto;
    padding: 0;
}

#session-list {
    background: $bg-panel;
    padding: 0;
}

.section-label {
    color: $text-muted;
    text-style: bold;
    padding: 0 1;
    height: 1;
}

.sidebar-item {
    padding: 0 2;
    height: 1;
    color: $text-dim;
}

.sidebar-item:hover {
    background: $bg-hover;
    color: $text;
}

.sidebar-item.--active {
    background: $bg-active;
    color: $accent;
}

.sidebar-item.--project {
    padding: 0 1;
}

#sidebar-footer {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    dock: bottom;
}

#session-search {
    background: $bg;
    border: tall $border;
    color: $text;
    height: 1;
    margin: 0 1;
    display: none;
}

#session-search:focus {
    border: tall $accent;
}

.sidebar-item--active {
    color: $accent;
    text-style: bold;
}

/* ── 임시 채팅 배너 ─────────────────────────────── */
#temp-banner {
    height: 1;
    background: #2d1f00;
    color: $warning;
    padding: 0 1;
    display: none;
}

#chat-pane.--temp #temp-banner {
    display: block;
}

/* 임시 채팅 시 입력창 박스를 amber 색으로 */
#chat-pane.--temp #input-bar {
    border: tall #6e4c00;
}

#chat-pane.--temp #input-bar:focus-within {
    border: tall $warning;
}

#chat-pane.--temp #action-btn.--send {
    color: #6e4c00;
}

/* ── 메인 채팅 영역 ───────────────────────────────── */
#chat-pane {
    width: 1fr;
    height: 100%;
    layout: vertical;
    background: $bg;
}

#chat-header {
    height: 1;
    background: $bg-panel;
    border-bottom: tall $border;
    padding: 0 1;
    color: $text-dim;
}

#chat-header-title {
    color: $accent;
    text-style: bold;
}

#chat-header-meta {
    color: $text-muted;
    text-align: right;
}

/* ── StatusBar / ProcessLog ─────────────────────── */
#status-bar {
    height: 1;
    background: $bg;
    border-top: tall $bg-active;
    padding: 0 1;
    color: $text-muted;
}

#process-log {
    background: $bg;
    border-top: tall $bg-active;
    border-bottom: tall $bg-active;
    display: none;
}

#process-log.--visible {
    display: block;
    height: 8;
}

#proc-log {
    background: $bg;
    padding: 0 1;
    scrollbar-background: $bg;
    scrollbar-color: $bg-active;
}

.msg-block {
    margin-bottom: 1;
    padding: 0;
}

.msg-role {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

.msg-role.--user {
    color: $accent2;
}

.msg-role.--assistant {
    color: $success;
}

.msg-content {
    color: $text;
    padding: 0 0 0 2;
    margin-bottom: 1;
}

.msg-content.--user {
    color: $text;
}

.msg-content.--assistant {
    color: $text;
}

.search-status {
    color: $warning;
    padding: 0 2;
    margin-bottom: 1;
}

.memory-badge {
    color: $text-muted;
    padding: 0 1;
    height: 1;
}

/* ── 입력창 ──────────────────────────────────────── */
#input-bar {
    height: 3;
    border: tall $border;
    background: $bg-panel;
    padding: 0 1;
    margin-bottom: 1;
}

/* 입력창에 포커스가 들어오면 외곽 박스 강조 */
#input-bar:focus-within {
    border: tall $accent;
}

#input-row {
    height: 1fr;
    align: left middle;
}

/* border 없음 — input-bar 박스가 프레임 역할 */
#input-field {
    width: 1fr;
    background: $bg;
    border: none;
    color: $text;
    height: 1fr;
    padding: 0 1;
}

/* 전송/중단 버튼: 5자폭 × 1행 ≈ 터미널 정사각형 비율
   모든 hover/상태에 border: none 명시 — 전역 Button:hover { border: tall } 오버라이드 */
#action-btn {
    width: 5;
    min-width: 5;
    height: 1fr;
    margin: 0 0 0 1;
    padding: 0 2;
    background: $bg-active;
    border: none;
    color: $text-muted;
}

#action-btn:hover {
    border: none;
}

#action-btn.--send:hover {
    color: $accent;
    background: $bg-hover;
    border: none;
}

#action-btn.--stop {
    background: #2d1a1a;
    color: #f85149;
    text-style: bold;
    border: none;
}

#action-btn.--stop:hover {
    background: #3d2020;
    border: none;
}

/* ── 자동완성 팝업 ────────────────────────────────── */
#autocomplete {
    background: $bg-active;
    border: tall $border;
    padding: 0;
    max-height: 10;
    width: 40;
}

.autocomplete-item {
    padding: 0 1;
    height: 1;
    color: $text-dim;
}

.autocomplete-item:hover,
.autocomplete-item.--selected {
    background: $bg-hover;
    color: $accent;
}

.autocomplete-desc {
    color: $text-muted;
}

/* ── 팝업 공통 ───────────────────────────────────── */
.modal-container {
    align: center middle;
    background: rgba(0,0,0,0.6);
}

.modal-box {
    background: $bg-panel;
    border: tall $border;
    padding: 1 2;
    min-width: 50;
    max-width: 70;
}

.modal-title {
    color: $accent;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

.modal-section {
    color: $text-muted;
    text-style: bold;
    height: 1;
    margin-top: 1;
}

.modal-input {
    background: $bg;
    border: tall $border;
    color: $text;
    margin-bottom: 1;
}

.modal-input:focus {
    border: tall $accent;
}

.modal-textarea {
    background: $bg;
    border: tall $border;
    color: $text;
    height: 5;
    margin-bottom: 1;
}

.modal-textarea:focus {
    border: tall $accent;
}

.modal-btn-row {
    align: center middle;
    height: 3;
    margin-top: 1;
}

Button {
    background: $bg-active;
    border: tall $border;
    color: $text;
    margin: 0 1;
}

Button:hover {
    background: $bg-hover;
    border: tall $accent;
    color: $accent;
}

Button.--primary {
    background: $accent;
    color: $bg;
    border: tall $accent;
}

Button.--primary:hover {
    background: $accent2;
}

Button.--danger {
    background: $error;
    color: $bg;
    border: tall $error;
}

/* ── 설정 화면 ───────────────────────────────────── */
#settings-list {
    background: $bg-panel;
    padding: 1 2;
}

.setting-row {
    height: 3;
    margin-bottom: 1;
}

.setting-label {
    width: 20;
    color: $text-dim;
    padding: 1 0;
}

.setting-value {
    background: $bg;
    border: tall $border;
    color: $text;
}

.setting-value:focus {
    border: tall $accent;
}

/* ── 키맵 힌트 바 ────────────────────────────────── */
#keybind-bar {
    height: 2;
    background: $bg-panel;
    border-top: tall $border;
    color: $text-muted;
    padding: 0 1;
}

.key-hint {
    color: $accent;
    text-style: bold;
}

/* ── 메모리 패널 ─────────────────────────────────── */
.memory-item-row {
    height: 1;
    padding: 0 1;
    color: $text-dim;
}

.memory-item-row:hover {
    background: $bg-hover;
}

.memory-source-manual {
    color: $accent;
}

.memory-source-auto {
    color: $warning;
}

/* ── Persona 패널 ────────────────────────────────── */
.persona-item-row {
    height: 1;
    padding: 0 1;
    color: $text-dim;
}

.persona-item-row:hover {
    background: $bg-hover;
}

.persona-item-row.--active {
    color: $success;
}

/* ── 입력창 버튼 hover override ─────────────────────
   전역 Button:hover { border: tall $accent } 가 파일 후반에 선언되어
   #action-btn:hover { border: none } 을 덮어씀.
   #input-bar 내부 Button 의 모든 상태에서 border: none 을 명시적으로 재선언.
   이 규칙이 파일 최하단에 위치해야 확실히 적용됨.            */
#input-bar Button,
#input-bar Button:hover,
#input-bar Button:focus,
#input-bar Button:focus-within {
    border: none;
    margin: 0;
}
